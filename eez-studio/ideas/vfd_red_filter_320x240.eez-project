          "fileName": "screens.h",
          "template": "#ifndef EEZ_LVGL_UI_SCREENS_H\n#define EEZ_LVGL_UI_SCREENS_H\n\n//${eez-studio LVGL_INCLUDE}\n\n#ifdef __cplusplus\nextern \"C\" {\n#endif\n\n//${eez-studio LVGL_SCREENS_DECL}\n//${eez-studio LVGL_SCREENS_DECL_EXT}\n\n#ifdef __cplusplus\n}\n#endif\n\n#endif /*EEZ_LVGL_UI_SCREENS_H*/"
        },
        {
          "objID": "14f38fa9-4d79-4064-b44f-f5bdac10190f",
          "fileName": "screens.c",
          "template": "#include \"screens.h\"\n#include \"images.h\"\n#include \"fonts.h\"\n#include \"actions.h\"\n#include \"vars.h\"\n#include \"styles.h\"\n#include \"ui.h\"\n\n//${eez-studio LVGL_SCREENS_DEF}\n//${eez-studio LVGL_SCREENS_DEF_EXT}"
        },
        {
          "objID": "f793141a-3957-446f-87f5-5c65a354afcf",
          "fileName": "actions.h",
          "template": "#ifndef EEZ_LVGL_UI_ACTIONS_H\n#define EEZ_LVGL_UI_ACTIONS_H\n\n//${eez-studio LVGL_INCLUDE}\n\n//${eez-studio LVGL_ACTIONS_DECL}\n\n#endif /*EEZ_LVGL_UI_ACTIONS_H*/"
        },
        {
          "objID": "7a821af3-e6c3-4df7-a9ed-0ccbf22dfcf6",
          "fileName": "vars.h",
          "template": "#ifndef EEZ_LVGL_UI_VARS_H\n#define EEZ_LVGL_UI_VARS_H\n\n#include <stdint.h>\n\n//${eez-studio LVGL_VARS_DECL}\n\n#endif /*EEZ_LVGL_UI_VARS_H*/"
        },
        {
          "objID": "1d8906f3-c187-4f53-b1a2-add7c0a6cde7",
          "fileName": "images.h",
          "template": "#ifndef EEZ_LVGL_UI_IMAGES_H\n#define EEZ_LVGL_UI_IMAGES_H\n\n//${eez-studio LVGL_INCLUDE}\n\n#ifdef __cplusplus\nextern \"C\" {\n#endif\n\n//${eez-studio LVGL_IMAGES_DECL}\n\n#ifdef __cplusplus\n}\n#endif\n\n#endif /*EEZ_LVGL_UI_IMAGES_H*/"
        },
        {
          "objID": "70b077e8-03a6-42a0-a338-cd3a8958d3a2",
          "fileName": "images.c",
          "template": "#include \"images.h\"\n\n//${eez-studio LVGL_IMAGES_DEF}"
        },
        {
          "objID": "3e95a070-cb7e-417a-93ec-0e54fbf5d0a2",
          "fileName": "fonts.h",
          "template": "#ifndef EEZ_LVGL_UI_FONTS_H\n#define EEZ_LVGL_UI_FONTS_H\n\n//${eez-studio LVGL_INCLUDE}\n//${eez-studio LVGL_FONTS_DECL}\n\n#endif /*EEZ_LVGL_UI_FONTS_H*/"
        },
        {
          "objID": "a904ed40-475a-4379-ade1-e841606e30a5",
          "fileName": "styles.h",
          "template": "#ifndef EEZ_LVGL_UI_STYLES_H\n#define EEZ_LVGL_UI_STYLES_H\n\n//${eez-studio LVGL_INCLUDE}\n\n#ifdef __cplusplus\nextern \"C\" {\n#endif\n\n//${eez-studio LVGL_STYLES_DECL}\n\n#ifdef __cplusplus\n}\n#endif\n\n#endif /*EEZ_LVGL_UI_STYLES_H*/"
        },
        {
          "objID": "55e3585d-5e22-49d5-ad61-c78331f40f4a",
          "fileName": "styles.c",
          "template": "#include \"styles.h\"\n#include \"images.h\"\n#include \"fonts.h\"\n\n//${eez-studio LVGL_STYLES_DEF}\n"
        },
        {
          "objID": "b632eaaa-9adf-4ed0-93e8-8f9059645d4d",
          "fileName": "ui.h",
          "template": "#ifndef EEZ_LVGL_UI_GUI_H\n#define EEZ_LVGL_UI_GUI_H\n\n//${eez-studio LVGL_INCLUDE}\n#include \"screens.h\"\n\n#ifdef __cplusplus\nextern \"C\" {\n#endif\n\nvoid ui_init();\nvoid ui_tick();\nvoid loadScreen(enum ScreensEnum screenId);\n\n#ifdef __cplusplus\n}\n#endif\n\n#endif // EEZ_LVGL_UI_GUI_H"
        },
        {
          "objID": "57224e6f-6865-44b0-a64a-f355117698ae",
          "fileName": "ui.c",
          "template": "#include \"ui.h\"\n#include \"images.h\"\n\nstatic int16_t currentScreen = -1;\n\nstatic lv_obj_t *getLvglObjectFromIndex(int32_t index) {\n    if (index == -1) {\n        return 0;\n    }\n    return ((lv_obj_t **)&objects)[index];\n}\n\nstatic const void *getLvglImageByName(const char *name) {\n    for (size_t imageIndex = 0; imageIndex < sizeof(images) / sizeof(ext_img_desc_t); imageIndex++) {\n        if (strcmp(images[imageIndex].name, name) == 0) {\n            return images[imageIndex].img_dsc;\n        }\n    }\n    return 0;\n}\n\nvoid loadScreen(enum ScreensEnum screenId) {\n    currentScreen = screenId - 1;\n    lv_obj_t *screen = getLvglObjectFromIndex(currentScreen);\n    lv_screen_load_anim(screen, LV_SCR_LOAD_ANIM_FADE_IN, 200, 0, false);\n}\n\nvoid ui_init() {\n    create_screens();\n    loadScreen(SCREEN_ID_MAIN);\n}\n\nvoid ui_tick() {\n    tick_screen(currentScreen);\n}\n"
        }
      ],
